{% extends 'base.html.twig' %}

{% block title %}Defence{% endblock %}

{% block body %}
    <h1>Defence</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ defence.id }}</td>
            </tr>
            <tr>
                <th>Name</th>
                <td>{{ defence.name }}</td>
            </tr>
            <tr>
                <th>Type</th>
                <td>{{ defence.type }}</td>
            </tr>
            <tr>
                <th>Metal</th>
                <td>{{ defence.metal }}</td>
            </tr>
            <tr>
                <th>Crystal</th>
                <td>{{ defence.crystal }}</td>
            </tr>
            <tr>
                <th>Deuterium</th>
                <td>{{ defence.deuterium }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_defence_index') }}">back to list</a>

    <a href="{{ path('app_defence_edit', {'id': defence.id}) }}">edit</a>

    {{ include('defence/_delete_form.html.twig') }}
{% endblock %}
