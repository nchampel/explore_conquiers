{% extends 'base.html.twig' %}

{% block title %}Building index{% endblock %}

{% block body %}
    <h1>Building index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>Type</th>
                <th>Metal</th>
                <th>Crystal</th>
                <th>Deuterium</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for building in buildings %}
            <tr>
                <td>{{ building.id }}</td>
                <td>{{ building.name }}</td>
                <td>{{ building.type }}</td>
                <td>{{ building.metal }}</td>
                <td>{{ building.crystal }}</td>
                <td>{{ building.deuterium }}</td>
                <td>
                    <a href="{{ path('app_building_show', {'id': building.id}) }}">show</a>
                    <a href="{{ path('app_building_edit', {'id': building.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="7">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_building_new') }}">Create new</a>
    <a href="{{ path('app_home_game_og') }}">accueil</a>
{% endblock %}
