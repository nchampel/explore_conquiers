                    const textContentIds = [
                        "diameterField", "diameterContentField",
                        "temperatureField", "temperatureContentField",
                        "positionField", "positionContentField",
                        "scoreField", "scoreContentField",
                    ];

                    let indexSequence = 0;

                    function startAnimation() {
                        // Si on a fini tous les éléments du tableau, on s'arrête (ou on peut relancer si vous voulez une boucle)
                        if (indexSequence >= textContent.length) return;

                        const target = textContentIds[indexSequence];
                        const element = document.getElementById(target);
                        const finalText = textContent[indexSequence];
                        let charIndex = 0;

                        function animate() {
                            if (charIndex <= finalText.length) {
                                // On extrait les caractères + l'underscore
                                element.textContent = finalText.substring(0, charIndex) + "_";
                                charIndex++;
                                setTimeout(animate, 10); // Votre vitesse de 25 ms
                            } else {
                                element.textContent = finalText;
                                // Fin de l'animation pour ce span, on passe au suivant après une petite pause
                                indexSequence++;
                                setTimeout(startAnimation, 200); // Pause de 0.8s avant le span suivant
                            }
                        }

                        animate();
                        // On réinitialise avec l'underscore seul
                        // element.textContent = "_";
                        // index = 0;

                        // const interval = setInterval(() => {
                        //     if (index < finalText.length) {
                        //         index++;
                        //         // On extrait les 'index' premiers caractères + l'underscore
                        //         element.textContent = finalText.substring(0, index) + "_";
                        //     } else if (index == finalText.length){
                        //         element.textContent = finalText;
                        //     } else {
                        //         // Fin de l'animation, on arrête l'intervalle
                        //         clearInterval(interval);
                            
                        //     }
                        // }, 25); // 100 ms de délai entre chaque caractère
                    }

                    // Lancement de l'animation au chargement
                    startAnimation();

                    // (Optionnel) Relancer l'animation toutes les 3 secondes en boucle
                    // setInterval(startAnimation, 4000);

                    // fin ajout

                    var loca = loca || {};

                    loca = $.extend({}, loca, {
                        error: "Erreur",
                        errorNotEnoughDM:
