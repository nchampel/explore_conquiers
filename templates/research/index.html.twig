{% extends 'base.html.twig' %}

{% block title %}Research index{% endblock %}

{% block body %}
    <h1>Research index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>Type</th>
                <th>Metal</th>
                <th>Crystal</th>
                <th>Deuterium</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for research in research %}
            <tr>
                <td>{{ research.id }}</td>
                <td>{{ research.name }}</td>
                <td>{{ research.type }}</td>
                <td>{{ research.metal }}</td>
                <td>{{ research.crystal }}</td>
                <td>{{ research.deuterium }}</td>
                <td>
                    <a href="{{ path('app_research_show', {'id': research.id}) }}">show</a>
                    <a href="{{ path('app_research_edit', {'id': research.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="7">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_research_new') }}">Create new</a>
    <a href="{{ path('app_home_game_og') }}">accueil</a>
{% endblock %}
