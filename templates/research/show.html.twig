{% extends 'base.html.twig' %}

{% block title %}Research{% endblock %}

{% block body %}
    <h1>Research</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ research.id }}</td>
            </tr>
            <tr>
                <th>Name</th>
                <td>{{ research.name }}</td>
            </tr>
            <tr>
                <th>Type</th>
                <td>{{ research.type }}</td>
            </tr>
            <tr>
                <th>Metal</th>
                <td>{{ research.metal }}</td>
            </tr>
            <tr>
                <th>Crystal</th>
                <td>{{ research.crystal }}</td>
            </tr>
            <tr>
                <th>Deuterium</th>
                <td>{{ research.deuterium }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_research_index') }}">back to list</a>

    <a href="{{ path('app_research_edit', {'id': research.id}) }}">edit</a>

    {{ include('research/_delete_form.html.twig') }}
{% endblock %}
