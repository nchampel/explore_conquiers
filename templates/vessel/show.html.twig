{% extends 'base.html.twig' %}

{% block title %}Vessel{% endblock %}

{% block body %}
    <h1>Vessel</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ vessel.id }}</td>
            </tr>
            <tr>
                <th>Name</th>
                <td>{{ vessel.name }}</td>
            </tr>
            <tr>
                <th>Type</th>
                <td>{{ vessel.type }}</td>
            </tr>
            <tr>
                <th>Metal</th>
                <td>{{ vessel.metal }}</td>
            </tr>
            <tr>
                <th>Crystal</th>
                <td>{{ vessel.crystal }}</td>
            </tr>
            <tr>
                <th>Deuterium</th>
                <td>{{ vessel.deuterium }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_vessel_index') }}">back to list</a>

    <a href="{{ path('app_vessel_edit', {'id': vessel.id}) }}">edit</a>

    {{ include('vessel/_delete_form.html.twig') }}
{% endblock %}
